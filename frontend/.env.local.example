# USDC trustline issuer — MAINNET Circle issuer (testnet uses GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5)
NEXT_PUBLIC_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Mock wallet (dev-only — leave unset in production)
# NEXT_PUBLIC_ENABLE_MOCK_WALLET=true
# NEXT_PUBLIC_MOCK_WALLET_SECRET=S...

# Faucet source secret key (required for /api/faucet — TESTNET ONLY.
# On mainnet the faucet route rejects requests; never set this in production.)
# MOCK_ACCOUNT_SECRET=S...

# Phase Transition Keeper (scripts/keeper.ts)
# Signer key; must be a group's admin to start_collection/advance_cycle.
# execute_payout works with any funded key.
# SOROBAN_SECRET_KEY=S...
# NEXT_PUBLIC_FACTORY_CONTRACT=  # auto-discovers this admin's groups; or set GROUPS
# GROUPS=                          # comma list of group ids to watch (overrides discovery)
# GROUPS_SKIP=                     # comma list of group ids to IGNORE even if discovered
#                                  # (e.g. deliberately-unfunded join-only cohorts)
# JOIN_GRACE_MINUTES=30            # dwell in Forming once full before starting
# COLLECTION_WINDOW_HOURS=48       # fallback stall alert for legacy groups w/o an
#                                  # on-chain deadline (live groups force-advance)
# BIDDING_WINDOW_HOURS=12          # dwell before execute_payout fires
# PAYOUT_COOLDOWN_MINUTES=10       # dwell in Payout before advance_cycle fires
